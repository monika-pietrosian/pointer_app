{
  "info": {
    "name": "Points Counter API",
    "description": "Tests for the Points Counter Express API (server/server.js).\n\nAuth is a signed session cookie (express-session), not a bearer token: run \"Login\" first and Postman's cookie jar carries `connect.sid` on every later request.\n\nThe requests are ordered and stateful — run the whole collection top to bottom in the Collection Runner. Running a single request out of order may fail its assertions.\n\nStart the server with the matching password:\n\n    TEACHER_PASSWORD=\"Regierunk\" npm start\n\nThe server does NOT read .env, so a plain `npm start` uses the default password `teacher` — set the `password` variable to match whichever you used.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "password",
      "value": "Regierunk",
      "type": "string"
    },
    {
      "key": "studentName",
      "value": "Ada Lovelace",
      "type": "string"
    },
    {
      "key": "studentId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login - wrong password (401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Start from a clean slate so a leftover cookie can't mask a 401.",
                  "const jar = pm.cookies.jar();",
                  "jar.clear(pm.variables.replaceIn('{{baseUrl}}'), (err) => {",
                  "    if (err) { console.log('cookie jar clear failed:', err); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects with 401', () => pm.response.to.have.status(401));",
                  "pm.test('returns the error message', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ error: 'Wrong password' });",
                  "});",
                  "pm.test('does not open a session', () => {",
                  "    // saveUninitialized:false means an untouched session sets no cookie.",
                  "    pm.expect(pm.response.headers.has('Set-Cookie')).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"definitely-not-the-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "checkPassword() requires an exact string match against TEACHER_PASSWORD."
          },
          "response": []
        },
        {
          "name": "Login - non-string password (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejects with 401', () => pm.response.to.have.status(401));",
                  "pm.test('returns the error message', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ error: 'Wrong password' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "checkPassword() has an explicit `typeof password === 'string'` guard, so truthy non-strings are rejected too."
          },
          "response": []
        },
        {
          "name": "Session - before login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports logged out', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ loggedIn: false });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "session"]
            },
            "description": "/api/session is unguarded — it always answers, it just reports the state."
          },
          "response": []
        },
        {
          "name": "Students - no session (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('guarded by requireAuth', () => pm.response.to.have.status(401));",
                  "pm.test('returns the error message', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ error: 'Not authenticated' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Every /api/students* route sits behind requireAuth."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns ok', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ ok: true });",
                  "});",
                  "pm.test('issues a session cookie', () => {",
                  "    pm.expect(pm.response.headers.has('Set-Cookie')).to.be.true;",
                  "    pm.expect(pm.response.headers.get('Set-Cookie')).to.include('connect.sid');",
                  "});",
                  "pm.test('cookie is httpOnly', () => {",
                  "    pm.expect(pm.response.headers.get('Set-Cookie')).to.include('HttpOnly');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "login"]
            },
            "description": "On success the server sets req.session.loggedIn and returns a connect.sid cookie. Postman stores it in the cookie jar for localhost and replays it automatically — no manual header needed."
          },
          "response": []
        },
        {
          "name": "Session - after login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports logged in', () => {",
                  "    pm.expect(pm.response.json()).to.eql({ loggedIn: true });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "session"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Students CRUD",
      "item": [
        {
          "name": "Create student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('returns the new student', () => {",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.name).to.eql(pm.variables.replaceIn('{{studentName}}'));",
                  "    pm.expect(body.points).to.eql(0);",
                  "});",
                  "pm.test('id is a positive number', () => {",
                  "    pm.expect(body.id).to.be.a('number').and.to.be.above(0);",
                  "});",
                  "",
                  "// Hand the id to every later request in the run.",
                  "pm.collectionVariables.set('studentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{studentName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            },
            "description": "Saves the returned id into the `studentId` collection variable for the requests that follow."
          },
          "response": []
        },
